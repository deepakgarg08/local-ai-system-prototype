FROM python:3.11

WORKDIR /app

# System deps (safe superset for FAISS / parsing)
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency metadata only
COPY pyproject.toml README.md ./

# Preinstall heavy deps explicitly (avoid source builds)
RUN pip install --no-cache-dir \
    faiss-cpu

# Install project + deps from pyproject.toml
RUN pip install --no-cache-dir .

